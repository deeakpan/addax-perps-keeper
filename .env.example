# Wallet that owns gTrade keeper NFT #1 (deployer after npm run deploy:gtrade)
KEEPER_PRIVATE_KEY=

PERPS_KEEPER_NFT_ID=1
PERPS_KEEPER_NFT_TYPE=1

# Event sync from redeploy block (contracts/deployments/liteforge-gtrade.json)
PERPS_DEPLOY_BLOCK=24989478

# Index all stacks (USDC + ADDX + WzkLTC) by default. Set to USDC|ADDX|WZKLTC for one stack only.
# PERPS_STACK=

# AddaxPriceFeed — same as oracle keeper
PERPS_DIA_ORACLE=0xFf856a958eFA7965A4dFC2BFb09dDbc9EABe9aAb

PONDER_RPC_URL=https://liteforge.rpc.caldera.xyz/http

# Loaded from repo root .env if unset here
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres

# poll = HTTP getLogs (recommended — Caldera WS often drops) | websocket = eth_subscribe
PERPS_SYNC_MODE=poll
PERPS_RPC_WS_URL=wss://liteforge.rpc.caldera.xyz/ws

# Liquidation mark sweep interval (positions sync is event-driven in websocket mode)
# PERPS_POLL_INTERVAL_MS=120000
